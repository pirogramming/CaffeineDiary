# ==========================================
# Caffeine Diary - 환경변수 예시
# ------------------------------------------
# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
#   cp .env.example .env
#
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 등록 필수)
# ==========================================


# ------------------------------------------
# Django
# ------------------------------------------

# 시크릿 키 (아래 명령으로 생성)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 개발: True / 배포: False
DJANGO_DEBUG=True

# 쉼표로 구분. 배포 시 실제 도메인·EC2 퍼블릭 IP 입력
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 배포 시 https 도메인 입력 (CSRF 검증용)
# 예: https://caffeine-diary.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000


# ------------------------------------------
# Database (MySQL)
# ------------------------------------------

DB_ENGINE=django.db.backends.mysql
DB_NAME=caffeine_diary
DB_USER=
DB_PASSWORD=

# 로컬 실행: 127.0.0.1
# docker compose 사용 시: db (서비스명)
DB_HOST=127.0.0.1
DB_PORT=3306

# docker-compose 의 MySQL 컨테이너 초기화용
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=caffeine_diary
MYSQL_USER=
MYSQL_PASSWORD=


# ------------------------------------------
# 세션 / 보안
# ------------------------------------------

# 배포(HTTPS) 환경에서는 True 로 변경
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# 세션 유지 시간 (초). 기본 30분
SESSION_COOKIE_AGE=1800


# ------------------------------------------
# 서비스 설정
# ------------------------------------------

# 시간대
TIME_ZONE=Asia/Seoul

# 하루 경계 시각 (시). 05 = 새벽 5시 기준으로 날짜 분리
DAY_BOUNDARY_HOUR=5

# 카페인 평균 반감기 (시간) - 집단 평균 PK 모델 상수
POP_HALF_LIFE_H=5.0

# 평균 분포용적 (L/kg)
POP_VD_L_PER_KG=0.6

# 체중 미입력 시 기본값 (kg)
DEFAULT_BODY_WEIGHT_KG=65.0

# 개인화 가중치 곡선의 기준 기록 수 (n0)
DEFAULT_N0=5

# ------------------------------------------
# 배포 (GitHub Actions / EC2)
# ------------------------------------------
# 아래 값들은 .env 가 아닌
# GitHub Repository > Settings > Secrets and variables > Actions
# 에 등록해서 사용합니다. 참고용으로만 남겨둡니다.
#
# EC2_HOST=
# EC2_USER=
# EC2_SSH_KEY=
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
